datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   // e.g., "SEO", "PPC", "Growth"
  clientName  String
  heroImage   String   // Cloudinary secure URL
  summary     String
  metrics     Json     // e.g., { "ROI": "450%", "Leads Generated": "+12k" }
  content     String   // Markdown or rich-text data
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  author     String
  role       String   // e.g., "CMO at TechCorp"
  avatarUrl  String?
  quote      String
  companyLog String?
  createdAt  DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WorkExperience {
  id          String   @id @default(cuid())
  company     String
  role        String
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  type        String   // "award" | "dashboard"
  title       String
  description String?
  imageUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// One cell of the hero stats row, e.g. value "$2M+" / label "Ad Spend Managed".
model HeroStat {
  id        String   @id @default(cuid())
  value     String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// One card in the "What I Do" section.
model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String   @default("◈") // single glyph shown above the title
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Singleton row (id = "singleton") holding editable site-wide settings.
model SiteSettings {
  id              String   @id @default("singleton")
  brandName       String   @default("Rifat Mashrur")
  metaTitle       String   @default("Rifat Mashrur — Digital Marketing")
  metaDescription String   @default("Data-driven digital marketing campaigns that convert.")
  tagline         String   @default("Data-driven digital marketing.")
  // Homepage section headings — editable so the sections aren't hard-coded.
  workTitle        String  @default("Selected Work")
  workSubtitle     String  @default("")
  servicesTitle    String  @default("What I Do")
  servicesSubtitle String  @default("Full-stack digital marketing capabilities built to work together.")
  email           String   @default("hello@studio.com")
  phone           String   @default("")
  colorCanvas     String   @default("#1A1917") // page background
  colorCream      String   @default("#F5EFE0") // primary text
  colorGreen      String   @default("#7CFC00") // brand accent
  profileImage    String   @default("") // hero / about photo URL
  faviconUrl      String   @default("") // browser tab icon URL
  ogImage         String   @default("") // social share (Open Graph) image URL
  passwordHash    String?  // scrypt "salt:hash"; null → fall back to ADMIN_PASSWORD env
  updatedAt       DateTime @updatedAt
}